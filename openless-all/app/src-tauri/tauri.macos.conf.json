{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "macOS": {
      "dmg": {
        "background": "dmg/installer-background@2x.png",
        "windowPosition": {
          "x": 120,
          "y": 120
        },
        "windowSize": {
          "width": 768,
          "height": 512
        },
        "appPosition": {
          "x": 216,
          "y": 253
        },
        "applicationFolderPosition": {
          "x": 552,
          "y": 253
        }
      },
      "frameworks": [
        "target/meeting-runtime-resources/libOpenLessMeetingAEC.dylib"
      ]
    },
    "externalBin": [
      "binaries/openless-native-capsule"
    ],
    "resources": {
      "target/meeting-runtime-resources/swift-transformers_Hub.bundle": "swift-transformers_Hub.bundle",
      "target/meeting-runtime-resources/swift-crypto_Crypto.bundle": "swift-crypto_Crypto.bundle",
      "vendor/licenses/": "licenses/meeting-runtime/",
      "vendor/webrtc-aec3/Notices/": "licenses/webrtc-aec3/"
    }
  },
  "build": {
    "beforeBuildCommand": "npm run build:native-capsule && npm run build",
    "beforeDevCommand": "npm run build:native-capsule:dev && npm run dev"
  }
}
